{
  "manifest_version": 3,
  "name": "Floorplan Collector",
  "version": "1.5.0",
  "description": "Capture, manage and export interactive SVG floorplans",
  "permissions": [
    "scripting",
    "storage",
    "downloads",
    "downloads.open",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "*://*.stipl.org/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "jszip.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
